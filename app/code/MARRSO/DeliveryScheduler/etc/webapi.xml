<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">

    <!-- ==================== PICKUP LOCATIONS API ==================== -->
    <route url="/V1/delivery/pickup-locations" method="GET">
        <service class="MARRSO\DeliveryScheduler\Api\GetPickupLocationsInterface" method="execute"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

    <!-- ==================== DELIVERY SLOTS API ==================== -->
    <route url="/V1/delivery/delivery-slots" method="GET">
        <service class="MARRSO\DeliveryScheduler\Api\GetDeliverySlotsInterface" method="execute"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

    <!-- ==================== SAVE DELIVERY SELECTION API ==================== -->
    <route url="/V1/delivery/save" method="POST">
        <service class="MARRSO\DeliveryScheduler\Api\SaveDeliverySelectionInterface" method="execute"/>
        <resources>
            <resource ref="self"/>
        </resources>
        <data>
            <parameter name="deliverySelection" force="true">object</parameter>
        </data>
    </route>

    <!-- ==================== PICKUP LOCATION REPOSITORY API ==================== -->
    <route url="/V1/pickup-locations" method="GET">
        <service class="MARRSO\DeliveryScheduler\Api\PickupLocationRepositoryInterface" method="getList"/>
        <resources>
            <resource ref="Magento_Backend::admin"/>
        </resources>
    </route>

    <route url="/V1/pickup-locations/:id" method="GET">
        <service class="MARRSO\DeliveryScheduler\Api\PickupLocationRepositoryInterface" method="getById"/>
        <resources>
            <resource ref="Magento_Backend::admin"/>
        </resources>
    </route>

    <route url="/V1/pickup-locations" method="POST">
        <service class="MARRSO\DeliveryScheduler\Api\PickupLocationRepositoryInterface" method="save"/>
        <resources>
            <resource ref="Magento_Backend::admin"/>
        </resources>
        <data>
            <parameter name="pickupLocation" force="true">object</parameter>
        </data>
    </route>

    <route url="/V1/pickup-locations/:id" method="PUT">
        <service class="MARRSO\DeliveryScheduler\Api\PickupLocationRepositoryInterface" method="save"/>
        <resources>
            <resource ref="Magento_Backend::admin"/>
        </resources>
        <data>
            <parameter name="pickupLocation" force="true">object</parameter>
        </data>
    </route>

    <route url="/V1/pickup-locations/:id" method="DELETE">
        <service class="MARRSO\DeliveryScheduler\Api\PickupLocationRepositoryInterface" method="deleteById"/>
        <resources>
            <resource ref="Magento_Backend::admin"/>
        </resources>
    </route>

