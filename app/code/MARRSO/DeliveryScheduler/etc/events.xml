<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="cron_schedule_generate_set_always">
        <observer name="marrso_delivery_scheduler_generate_slots" instance="MARRSO\DeliveryScheduler\Observer\GenerateSlotsObserver"/>
    </event>

    <event name="sales_model_service_quote_submit_before">
        <observer name="marrso_delivery_scheduler_quote_submit" instance="MARRSO\DeliveryScheduler\Observer\QuoteSubmitObserver"/>
    </event>

    <event name="checkout_cart_product_add_after">
        <observer name="marrso_delivery_scheduler_validate_availability" instance="MARRSO\DeliveryScheduler\Observer\ValidateAvailabilityObserver"/>
    </event>
</config>
