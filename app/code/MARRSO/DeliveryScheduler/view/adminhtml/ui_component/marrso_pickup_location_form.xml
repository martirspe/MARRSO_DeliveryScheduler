<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd"
      name="marrso_pickup_location_form">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">marrso_pickup_location_form.marrso_pickup_location_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Pickup Location</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <namespace>marrso_pickup_location_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>marrso_pickup_location_form.marrso_pickup_location_form_data_source</dep>
        </deps>
        <buttons>
            <button name="save" class="MARRSO\DeliveryScheduler\Block\Adminhtml\Component\Button\SaveButton"/>
            <button name="back" class="MARRSO\DeliveryScheduler\Block\Adminhtml\Component\Button\BackButton"/>
        </buttons>
    </settings>
    <dataSource name="marrso_pickup_location_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="marrso_delivery_scheduler/pickuplocation/save"/>
        </settings>
        <dataProvider class="MARRSO\DeliveryScheduler\Model\DataProvider\PickupLocationDataProvider" name="marrso_pickup_location_form_data_source">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">General Information</label>
        </settings>
        <field name="entity_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
        </field>
        <field name="name" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Name</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="code" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Code</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="address" formElement="textarea">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Address</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="district" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">District</label>
            </settings>
        </field>
        <field name="brand" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Brand</label>
                <notice translate="true">e.g. Falabella, Sodimac, Mallplaza</notice>
            </settings>
        </field>
        <field name="location_references" formElement="textarea">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Pickup References</label>
                <notice translate="true">Directions to find the pickup desk inside the location.</notice>
            </settings>
        </field>
        <field name="opening_hours" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Opening Hours</label>
                <notice translate="true">e.g. Mon-Sun 11:00-19:00</notice>
            </settings>
        </field>
        <field name="retention_days" formElement="input">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Retention Days</label>
                <notice translate="true">Days the order is held before cancellation.</notice>
                <validation>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                    <rule name="validate-greater-than-zero" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="auto_generate_slots" formElement="checkbox">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Auto-generate Slots (Cron)</label>
                <notice translate="true">When disabled, only manually created pickup slots are used. Saving a slot in Pickup Slots also disables this.</notice>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="latitude" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Latitude</label>
            </settings>
        </field>
        <field name="longitude" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Longitude</label>
            </settings>
        </field>
        <field name="priority" formElement="input">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Priority</label>
            </settings>
        </field>
        <field name="is_active" formElement="checkbox">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Active</label>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>
</form>
