<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd"
      name="marrso_holiday_form">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">marrso_holiday_form.marrso_holiday_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Holiday</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <namespace>marrso_holiday_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>marrso_holiday_form.marrso_holiday_form_data_source</dep>
        </deps>
        <buttons>
            <button name="save" class="MARRSO\DeliveryScheduler\Block\Adminhtml\Component\Button\SaveButton"/>
            <button name="back" class="MARRSO\DeliveryScheduler\Block\Adminhtml\Component\Button\BackButton"/>
        </buttons>
    </settings>
    <dataSource name="marrso_holiday_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="marrso_delivery_scheduler/holiday/save"/>
        </settings>
        <dataProvider class="MARRSO\DeliveryScheduler\Model\DataProvider\HolidayDataProvider" name="marrso_holiday_form_data_source">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">Holiday Information</label>
        </settings>
        <field name="entity_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
        </field>
        <field name="holiday_date" formElement="date">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Date</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="description" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Description</label>
            </settings>
        </field>
    </fieldset>
</form>
