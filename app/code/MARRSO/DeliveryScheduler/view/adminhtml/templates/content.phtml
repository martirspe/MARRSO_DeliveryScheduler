<?php
/** @var \MARRSO\DeliveryScheduler\Block\Adminhtml\Content $block */
?>
<div class="marrso-admin-content">
    <?php if ($block->getDescription()): ?>
        <p><?= $block->escapeHtml((string)$block->getDescription()) ?></p>
    <?php endif; ?>

    <?php if (!$block->hasRows()): ?>
        <div class="message message-notice">
            <div><?= $block->escapeHtml((string)$block->getEmptyMessage()) ?></div>
        </div>
        <?php return; ?>
    <?php endif; ?>

    <table class="data-grid admin__table-primary">
        <thead>
            <tr>
                <?php foreach ($block->getHeaders() as $header): ?>
                    <th><?= $block->escapeHtml((string)$header) ?></th>
                <?php endforeach; ?>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($block->getRows() as $row): ?>
                <tr>
                    <?php foreach ($block->getHeaders() as $header): ?>
                        <td><?= $block->escapeHtml((string)($row[$header] ?? '')) ?></td>
                    <?php endforeach; ?>
                </tr>
            <?php endforeach; ?>
        </tbody>
    </table>
</div>
